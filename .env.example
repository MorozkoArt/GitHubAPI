# ===============================
# GitHub API configuration
# ===============================
# Основной токен GitHub
GITHUB_TOKEN=your_github_token_here
# Токен пользователя (используется при AUTH_METHOD=token)
GITHUB_USER_TOKEN=
# Имя пользователя GitHub (используется при AUTH_METHOD=login)
GITHUB_USERNAME=your_github_username_here

# ===============================
# Project paths (inside container)
# ===============================
PROJECT_ROOT=/app
DATA_DIR=/app/data
OUTPUT_DIR=/app/output
# Пути к ML-артефактам
MODEL_PATH=/app/data/best_model.pth
SCALER_PATH=/app/data/scaler.pth

# ===============================
# Application behavior
# ===============================
# Метод аутентификации:
# login  — через GITHUB_TOKEN + GITHUB_USERNAME
# token  — через GITHUB_USER_TOKEN
AUTH_METHOD=login
# Уровень доступа:
# public | private
ACCESS_LEVEL=public
# Режим оценки кода:
# 1 — анализ всех файлов
# 2 — анализ первых пяти файлов
CODE_ASSESS_MODE=2

# ===============================
# Parallelism / performance
# ===============================
# Максимальное количество потоков при обработке пользователей
MAX_WORKERS_USER=5
# Максимальное количество потоков при обработке репозиториев
MAX_WORKERS_REPO=10
